+void Engine_Ext_DebyeMaterial::ThreadRange(int threadID, unsigned int &start, unsigned int &stop) const
+{
+	unsigned int count = m_Op_Ext_Deb->m_LM_Count.at(0);
+	unsigned int nThreads = m_NrThreads>0 ? (unsigned int)m_NrThreads : 1;
+	unsigned int chunk = (count + nThreads - 1) / nThreads;
+	start = std::min(count, chunk*(unsigned int)threadID);
+	stop  = std::min(count, start + chunk);
+}

+template <typename EngType>
+void Engine_Ext_DebyeMaterial::Apply2VoltagesRangeImpl(EngType* eng, unsigned int start, unsigned int stop)
+{
+	// same as Engine_Ext_Dispersive::Apply2VoltagesImpl for the single (joint) order the Debye operator uses
+	unsigned int **pos = m_Op_Ext_Deb->m_LM_pos[0];
+	for (unsigned int i=start; i<stop; ++i)
+		for (int n=0; n<3; ++n)
+			eng->EngType::SetVolt(n,pos[0][i],pos[1][i],pos[2][i],
+				eng->EngType::GetVolt(n,pos[0][i],pos[1][i],pos[2][i]) - volt_ADE[0][n][i]);
+}
+
+void Engine_Ext_DebyeMaterial::Apply2Voltages(int threadID)
+{
+	unsigned int start, stop;
+	ThreadRange(threadID, start, stop);
+	ENG_DISPATCH_ARGS(Apply2VoltagesRangeImpl, start, stop);
 }
